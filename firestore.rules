rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (optional)
    //   - email: string (required)
    //   - photoURL: string (optional)
    //   - createdAt: timestamp (required)
    //
    // Collection: results
    // Document ID: {resultId}
    // Fields:
    //   - uid: string (required)
    //   - sectionId: string (required)
    //   - sectionTitle: string (required)
    //   - score: number (required)
    //   - correctAnswers: number (required)
    //   - totalQuestions: number (required)
    //   - completedAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "bt4ylor1776@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidEmail(email) {
      return email is string && email.matches("^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+$");
    }

    function isValidUser(data) {
      let allowedFields = ['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'hasPurchased', 'purchasedAt', 'stripeSessionId', 'badges'];
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('hasPurchased' in data) || data.hasPurchased is bool) &&
             (!('purchasedAt' in data) || data.purchasedAt is timestamp) &&
             (!('stripeSessionId' in data) || (data.stripeSessionId is string && data.stripeSessionId.size() < 200)) &&
             (!('badges' in data) || (data.badges is list && data.badges.size() <= 50));
    }

    function isValidResult(data) {
      return data.keys().hasOnly(['uid', 'sectionId', 'sectionTitle', 'score', 'correctAnswers', 'totalQuestions', 'completedAt']) &&
             data.uid == request.auth.uid &&
             data.sectionId is string && data.sectionId.size() < 50 &&
             data.sectionTitle is string && data.sectionTitle.size() < 200 &&
             data.score is number && data.score >= 0 && data.score <= 100 &&
             data.correctAnswers is number && data.correctAnswers >= 0 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.completedAt is timestamp;
    }

    function isSystemFieldModified(field) {
      return field in request.resource.data && (
        !(field in resource.data) || request.resource.data[field] != resource.data[field]
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Users can create their own profile, but cannot set payment status
      allow create: if isAuthenticated() && isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      !('hasPurchased' in request.resource.data) &&
                      !('purchasedAt' in request.resource.data) &&
                      !('stripeSessionId' in request.resource.data);
      
      // Users can update their profile, but cannot modify payment status
      allow update: if isAuthenticated() && isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      !isSystemFieldModified('hasPurchased') &&
                      !isSystemFieldModified('purchasedAt') &&
                      !isSystemFieldModified('stripeSessionId');
    }

    match /results/{resultId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidResult(request.resource.data);
      allow update: if false; // Results should be immutable
      allow delete: if isDocOwner();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
