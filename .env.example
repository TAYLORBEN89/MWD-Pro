# =========================================================================
# BACKEND (SERVER-SIDE) SECRETS
# These stay in your .env file. Do NOT commit them to GitHub.
# =========================================================================

# Stripe Secret Key (Starts with sk_test_... or sk_live_...)
# Used by the server to create Checkout Sessions.
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Secret (Starts with whsec_...)
# Used to verify that events are actually coming from Stripe.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Play (Optional: only if you implement Play Store verification)
# The JSON string of your service account key.
GOOGLE_PLAY_SERVICE_ACCOUNT='{"type": "service_account", ...}'


# =========================================================================
# FRONTEND (CLIENT-SIDE) PUBLIC KEYS
# These MUST start with VITE_ to be visible in the React app.
# =========================================================================

# Stripe Publishable Key (Starts with pk_test_... or pk_live_...)
# Used by the browser to load the Stripe UI.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# App URL Configuration
# LOCAL: Use http://localhost:3000
# PRODUCTION: Use your actual production domain (e.g., https://compessential.com)
VITE_APP_URL="https://compessential.com"
APP_URL="https://compessential.com"


# =========================================================================
# FIREBASE CONFIGURATION
# These values are found in your Firebase Project Settings -> General -> Your Apps.
# =========================================================================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="YOUR_FIREBASE_DATABASE_ID"

# =========================================================================
# GOOGLE_PLAY_SERVICE_ACCOUNT (The play-store-verifier key)
# Paste the ENTIRE JSON content from your downloaded service account key file here.
# =========================================================================
GOOGLE_PLAY_SERVICE_ACCOUNT='{ "type": "service_account", "project_id": "YOUR_PROJECT_ID", ... }'
